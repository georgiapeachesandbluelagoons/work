// Airtable Script: Attendance matrix with exact linked-record matching and diagnostics
const rostersTable = base.getTable("Ensemble Rosters");
const rehearsalsTable = base.getTable("Rehearsals/Concerts");
const attendanceTable = base.getTable("Attendance");
const absencesTable = base.getTable("Absence Requests");

const ROSTER_STUDENT_FIELD = "Student";
const ROSTER_ENSEMBLE_FIELD = "Ensemble Registered";
const REHEARSAL_DATE_FIELD = "Rehearsal Date";
const REHEARSAL_ENSEMBLE_FIELD = "Ensemble(s)";
const ATTENDANCE_REHEARSAL_FIELD = "Date of Attendance";
const ATTENDANCE_STUDENT_FIELD = "Student";
const ABSENCE_REHEARSAL_FIELD = "Absence Date";
const ABSENCE_STUDENT_FIELD = "Student Name";
const ABSENCE_TYPE_FIELD = "Absence Type";

function linkedRecords(value) {
    if (!value) return [];
    return Array.isArray(value) ? value : [value];
}

function linkedIds(value) {
    return new Set(linkedRecords(value).map(item => {
        if (typeof item === "string") return item;
        return item?.id;
    }).filter(Boolean));
}

function linkedNames(value) {
    return new Set(linkedRecords(value).map(item => {
        if (typeof item === "string") return item.trim().toLowerCase();
        return String(item?.name || item?.value || "").trim().toLowerCase();
    }).filter(Boolean));
}

function dateKey(value) {
    if (!value) return null;
    if (value instanceof Date) {
        return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, "0")}-${String(value.getDate()).padStart(2, "0")}`;
    }
    const raw = String(value);
    const iso = raw.match(/(\d{4})-(\d{2})-(\d{2})/);
    if (iso) return `${iso[1]}-${iso[2]}-${iso[3]}`;
    const us = raw.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
    return us ? `${us[3]}-${String(us[1]).padStart(2, "0")}-${String(us[2]).padStart(2, "0")}` : null;
}

function displayDate(key) {
    const [year, month, day] = key.split("-").map(Number);
    return `${month}/${day}/${year}`;
}

function studentName(rosterRecord) {
    const linkedStudent = linkedRecords(rosterRecord.getCellValue(ROSTER_STUDENT_FIELD))[0];
    return linkedStudent?.name || rosterRecord.name || "Unnamed Student";
}

function absenceStatus(value) {
    const status = String(value?.name || value?.value || value || "").trim().toLowerCase();
    if (status.includes("excus")) return "Excused";
    if (status.includes("tardy") || status.includes("late")) return "Tardy";
    if (status.includes("early") || status.includes("dismiss")) return "Leaving Early";
    return "Absent";
}

const rehearsalQuery = await rehearsalsTable.selectRecordsAsync({
    fields: [REHEARSAL_DATE_FIELD, REHEARSAL_ENSEMBLE_FIELD]
});

const ensembleOptions = [];
const seenEnsembles = new Set();
for (const rehearsal of rehearsalQuery.records) {
    for (const ensemble of linkedRecords(rehearsal.getCellValue(REHEARSAL_ENSEMBLE_FIELD))) {
        if (ensemble?.id && ensemble.name && !seenEnsembles.has(ensemble.id)) {
            seenEnsembles.add(ensemble.id);
            ensembleOptions.push({ id: ensemble.id, name: ensemble.name });
        }
    }
}
ensembleOptions.sort((a, b) => a.name.localeCompare(b.name));

if (ensembleOptions.length === 0) {
    output.text("❌ No ensembles were found in Rehearsals/Concerts.");
} else {
    const selectedName = await input.buttonsAsync(
        "Select the ensemble:",
        ensembleOptions.map(option => option.name)
    );
    const selectedEnsemble = ensembleOptions.find(option => option.name === selectedName);

    if (!selectedEnsemble) {
        output.text("❌ No ensemble was selected.");
    } else {
        const columns = rehearsalQuery.records
            .filter(rehearsal => linkedIds(rehearsal.getCellValue(REHEARSAL_ENSEMBLE_FIELD)).has(selectedEnsemble.id))
            .map(rehearsal => ({
                id: rehearsal.id,
                date: dateKey(rehearsal.getCellValue(REHEARSAL_DATE_FIELD))
            }))
            .filter(column => column.date)
            .sort((a, b) => a.date.localeCompare(b.date) || a.id.localeCompare(b.id));

        const rosterQuery = await rostersTable.selectRecordsAsync({
            fields: [ROSTER_STUDENT_FIELD, ROSTER_ENSEMBLE_FIELD]
        });
        const students = rosterQuery.records
            .filter(roster => linkedIds(roster.getCellValue(ROSTER_ENSEMBLE_FIELD)).has(selectedEnsemble.id))
            .sort((a, b) => studentName(a).localeCompare(studentName(b)));

        const attendanceQuery = await attendanceTable.selectRecordsAsync({
            fields: [ATTENDANCE_REHEARSAL_FIELD, ATTENDANCE_STUDENT_FIELD]
        });
        const status = new Map();
        let recordsWithRehearsal = 0;
        let recordsWithStudent = 0;
        let matchedAttendance = 0;

        for (const attendance of attendanceQuery.records) {
            const rehearsalIds = linkedIds(attendance.getCellValue(ATTENDANCE_REHEARSAL_FIELD));
            const studentIds = linkedIds(attendance.getCellValue(ATTENDANCE_STUDENT_FIELD));
            const studentNames = linkedNames(attendance.getCellValue(ATTENDANCE_STUDENT_FIELD));
            const matchingColumns = columns.filter(column => rehearsalIds.has(column.id));

            if (matchingColumns.length) recordsWithRehearsal++;
            if (studentIds.size || studentNames.size) recordsWithStudent++;
            if (!matchingColumns.length || (!studentIds.size && !studentNames.size)) continue;

            for (const column of matchingColumns) {
                for (const id of studentIds) status.set(`${id}|${column.id}`, "Present");
                for (const name of studentNames) status.set(`name:${name}|${column.id}`, "Present");
            }
            matchedAttendance++;
        }

        const absenceQuery = await absencesTable.selectRecordsAsync({
            fields: [ABSENCE_REHEARSAL_FIELD, ABSENCE_STUDENT_FIELD, ABSENCE_TYPE_FIELD]
        });
        for (const absence of absenceQuery.records) {
            const rehearsalIds = linkedIds(absence.getCellValue(ABSENCE_REHEARSAL_FIELD));
            const studentIds = linkedIds(absence.getCellValue(ABSENCE_STUDENT_FIELD));
            const type = absenceStatus(absence.getCellValue(ABSENCE_TYPE_FIELD));
            for (const column of columns) {
                if (!rehearsalIds.has(column.id)) continue;
                for (const id of studentIds) {
                    const key = `${id}|${column.id}`;
                    if (!status.has(key)) status.set(key, type);
                }
            }
        }

        const headers = [];
        const used = new Set();
        for (const column of columns) {
            let header = displayDate(column.date);
            if (used.has(header)) header = `${header} (${column.id.slice(-4)})`;
            used.add(displayDate(column.date));
            headers.push(header);
        }

        const rows = students.map(roster => {
            const row = { "Student Name": studentName(roster) };
            const rosterName = studentName(roster).trim().toLowerCase();
            for (let index = 0; index < columns.length; index++) {
                const column = columns[index];
                const value = status.get(`${roster.id}|${column.id}`)
                    || status.get(`name:${rosterName}|${column.id}`)
                    || "";
                row[headers[index]] = value;
            }
            return row;
        });

        output.text(`## ${selectedName}`);
        output.text(`${students.length} roster students | ${columns.length} rehearsal columns | ${matchedAttendance} attendance records matched`);
        output.text(`Diagnostic: ${recordsWithRehearsal} attendance records had a matching rehearsal link; ${recordsWithStudent} had a Student value.`);
        output.table(rows);
    }
}
