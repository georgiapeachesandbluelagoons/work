// Airtable Script: Attendance matrix keyed by exact roster and rehearsal record IDs
const rostersTable = base.getTable("Ensemble Rosters");
const rehearsalsTable = base.getTable("Rehearsals/Concerts");
const attendanceTable = base.getTable("Attendance");
const absencesTable = base.getTable("Absence Requests");

const ROSTER_STUDENT_FIELD = "Student";
const ROSTER_ENSEMBLE_FIELD = "Ensemble Registered";
const REHEARSAL_DATE_FIELD = "Rehearsal Date";
const REHEARSAL_ENSEMBLE_FIELD = "Ensemble(s)";
const ATTENDANCE_REHEARSAL_FIELD = "Date of Attendance";
const ATTENDANCE_STUDENT_FIELD = "Student";
const ABSENCE_REHEARSAL_FIELD = "Absence Date";
const ABSENCE_STUDENT_FIELD = "Student Name";
const ABSENCE_TYPE_FIELD = "Absence Type";

function linkedValues(value) {
    if (!value) return [];
    return Array.isArray(value) ? value : [value];
}

function linkedIds(value) {
    return new Set(
        linkedValues(value)
            .map(item => (typeof item === "string" ? item : item?.id))
            .filter(Boolean)
    );
}

function linkedNames(value) {
    return new Set(
        linkedValues(value)
            .map(item => {
                if (typeof item === "string") return item.trim().toLowerCase();
                return String(item?.name || item?.value || "").trim().toLowerCase();
            })
            .filter(Boolean)
    );
}

function normalizedName(value) {
    return String(value || "").trim().toLowerCase();
}

function dateKey(value) {
    if (!value) return null;
    if (value instanceof Date) {
        return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, "0")}-${String(value.getDate()).padStart(2, "0")}`;
    }

    const raw = String(value);
    const iso = raw.match(/(\d{4})-(\d{2})-(\d{2})/);
    if (iso) return `${iso[1]}-${iso[2]}-${iso[3]}`;

    const us = raw.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
    if (us) return `${us[3]}-${String(us[1]).padStart(2, "0")}-${String(us[2]).padStart(2, "0")}`;

    return null;
}

function displayDate(key) {
    if (!key) return "";
    const [year, month, day] = key.split("-").map(Number);
    return `${month}/${day}/${year}`;
}

function rosterStudentName(rosterRecord) {
    const linkedStudent = linkedValues(rosterRecord.getCellValue(ROSTER_STUDENT_FIELD))[0];
    return linkedStudent?.name || rosterRecord.name || "Unnamed Student";
}

function absenceStatus(value) {
    const text = String(value?.name || value?.value || value || "").trim().toLowerCase();
    if (text.includes("excus")) return "Excused";
    if (text.includes("tardy") || text.includes("late")) return "Tardy";
    if (text.includes("early") || text.includes("dismiss")) return "Leaving Early";
    return "Absent";
}

const rehearsalQuery = await rehearsalsTable.selectRecordsAsync({
    fields: [REHEARSAL_DATE_FIELD, REHEARSAL_ENSEMBLE_FIELD]
});

const ensembleOptions = [];
const seenEnsembleIds = new Set();

for (const rehearsal of rehearsalQuery.records) {
    for (const ensemble of linkedValues(rehearsal.getCellValue(REHEARSAL_ENSEMBLE_FIELD))) {
        if (ensemble?.id && ensemble.name && !seenEnsembleIds.has(ensemble.id)) {
            seenEnsembleIds.add(ensemble.id);
            ensembleOptions.push({ id: ensemble.id, name: ensemble.name });
        }
    }
}

ensembleOptions.sort((a, b) => a.name.localeCompare(b.name));

if (ensembleOptions.length === 0) {
    output.text("❌ No ensembles were found in Rehearsals/Concerts.");
} else {
    const selectedEnsembleName = await input.buttonsAsync(
        "Select the ensemble:",
        ensembleOptions.map(option => option.name)
    );

    const selectedEnsemble = ensembleOptions.find(option => option.name === selectedEnsembleName);

    if (!selectedEnsemble) {
        output.text("❌ No ensemble was selected.");
    } else {
        const rehearsalColumns = rehearsalQuery.records
            .filter(rehearsal => linkedIds(rehearsal.getCellValue(REHEARSAL_ENSEMBLE_FIELD)).has(selectedEnsemble.id))
            .map(rehearsal => ({
                id: rehearsal.id,
                date: dateKey(rehearsal.getCellValue(REHEARSAL_DATE_FIELD))
            }))
            .filter(column => column.date)
            .sort((a, b) => a.date.localeCompare(b.date) || a.id.localeCompare(b.id));

        const selectedRehearsalIds = new Set(rehearsalColumns.map(column => column.id));

        if (rehearsalColumns.length === 0) {
            output.text(`❌ No rehearsal dates found for ${selectedEnsembleName}.`);
        } else {
            const rosterQuery = await rostersTable.selectRecordsAsync({
                fields: [ROSTER_STUDENT_FIELD, ROSTER_ENSEMBLE_FIELD]
            });

            const students = rosterQuery.records
                .filter(rosterRecord => linkedIds(rosterRecord.getCellValue(ROSTER_ENSEMBLE_FIELD)).has(selectedEnsemble.id))
                .sort((a, b) => rosterStudentName(a).localeCompare(rosterStudentName(b)));

            const statusByStudentAndRehearsal = new Map();

            const attendanceQuery = await attendanceTable.selectRecordsAsync({
                fields: [ATTENDANCE_REHEARSAL_FIELD, ATTENDANCE_STUDENT_FIELD]
            });

            for (const attendance of attendanceQuery.records) {
                const rehearsalIds = linkedIds(attendance.getCellValue(ATTENDANCE_REHEARSAL_FIELD));
                const studentIds = linkedIds(attendance.getCellValue(ATTENDANCE_STUDENT_FIELD));
                const studentNames = linkedNames(attendance.getCellValue(ATTENDANCE_STUDENT_FIELD));

                const matchingRehearsalIds = rehearsalColumns
                    .filter(column => rehearsalIds.has(column.id))
                    .map(column => column.id);

                if (matchingRehearsalIds.length === 0) continue;

                for (const studentId of studentIds) {
                    if (!students.some(student => student.id === studentId)) continue;
                    for (const rehearsalId of matchingRehearsalIds) {
                        statusByStudentAndRehearsal.set(`${studentId}|${rehearsalId}`, "Present");
                    }
                }

                for (const studentName of studentNames) {
                    for (const rehearsalId of matchingRehearsalIds) {
                        statusByStudentAndRehearsal.set(`name:${studentName}|${rehearsalId}`, "Present");
                    }
                }
            }

            const absenceQuery = await absencesTable.selectRecordsAsync({
                fields: [ABSENCE_REHEARSAL_FIELD, ABSENCE_STUDENT_FIELD, ABSENCE_TYPE_FIELD]
            });

            for (const absence of absenceQuery.records) {
                const rehearsalIds = linkedIds(absence.getCellValue(ABSENCE_REHEARSAL_FIELD));
                const studentIds = linkedIds(absence.getCellValue(ABSENCE_STUDENT_FIELD));
                const studentNames = linkedNames(absence.getCellValue(ABSENCE_STUDENT_FIELD));
                const type = absenceStatus(absence.getCellValue(ABSENCE_TYPE_FIELD));

                for (const studentId of studentIds) {
                    if (!students.some(student => student.id === studentId)) continue;
                    for (const rehearsalId of rehearsalColumns.map(column => column.id)) {
                        if (!rehearsalIds.has(rehearsalId)) continue;
                        const key = `${studentId}|${rehearsalId}`;
                        if (!statusByStudentAndRehearsal.has(key)) {
                            statusByStudentAndRehearsal.set(key, type);
                        }
                    }
                }

                for (const studentName of studentNames) {
                    for (const rehearsalId of rehearsalColumns.map(column => column.id)) {
                        if (!rehearsalIds.has(rehearsalId)) continue;
                        const key = `name:${studentName}|${rehearsalId}`;
                        if (!statusByStudentAndRehearsal.has(key)) {
                            statusByStudentAndRehearsal.set(key, type);
                        }
                    }
                }
            }

            const headers = [];
            const usedHeaders = new Set();
            for (const column of rehearsalColumns) {
                const baseHeader = displayDate(column.date);
                let header = baseHeader;
                if (usedHeaders.has(baseHeader)) header = `${baseHeader} (${column.id.slice(-4)})`;
                usedHeaders.add(baseHeader);
                headers.push(header);
            }

            const rows = students.map(student => {
                const row = { "Student Name": rosterStudentName(student) };
                const rosterName = normalizedName(rosterStudentName(student));

                for (let i = 0; i < rehearsalColumns.length; i++) {
                    const column = rehearsalColumns[i];
                    const value = statusByStudentAndRehearsal.get(`${student.id}|${column.id}`)
                        || statusByStudentAndRehearsal.get(`name:${rosterName}|${column.id}`)
                        || "";
                    row[headers[i]] = value;
                }

                return row;
            });

            output.text(`## ${selectedEnsembleName}`);
            output.text(`${students.length} students | ${rehearsalColumns.length} rehearsal records`);
            output.table(rows);
        }
    }
}
