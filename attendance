// Airtable Script: Attendance matrix with exact rehearsal matching and linked/lookup student support
const rostersTable = base.getTable("Ensemble Rosters");
const rehearsalsTable = base.getTable("Rehearsals/Concerts");
const attendanceTable = base.getTable("Attendance");
const absencesTable = base.getTable("Absence Requests");

const rosterPrimaryField = "Student";
const attendanceDateField = "Date of Attendance";
const attendanceStudentField = "Student";
const absenceDateField = "Absence Date";
const absenceStudentField = "Student Name";
const absenceTypeField = "Absence Type";

function values(value) {
    if (!value) return [];
    return Array.isArray(value) ? value : [value];
}

function text(value) {
    if (value == null) return "";
    if (typeof value === "string" || typeof value === "number") return String(value).trim();
    return String(value.name || value.value || value.text || "").trim();
}

function normalized(value) {
    return text(value).toLowerCase().replace(/\s+/g, " ");
}

function dateKey(value) {
    if (!value) return null;
    if (value instanceof Date) {
        return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, "0")}-${String(value.getDate()).padStart(2, "0")}`;
    }

    const stringValue = String(value);
    const iso = stringValue.match(/(\d{4})-(\d{2})-(\d{2})/);
    if (iso) return `${iso[1]}-${iso[2]}-${iso[3]}`;

    const us = stringValue.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
    if (us) return `${us[3]}-${String(us[1]).padStart(2, "0")}-${String(us[2]).padStart(2, "0")}`;

    return null;
}

function displayDate(key) {
    const [year, month, day] = key.split("-").map(Number);
    return `${month}/${day}/${year}`;
}

function ids(value) {
    return values(value).map(item => item?.id).filter(Boolean);
}

function aliases(value) {
    const result = new Set();
    for (const item of values(value)) {
        if (item?.id) result.add(`id:${item.id}`);
        const name = normalized(item);
        if (name) result.add(`name:${name}`);
    }
    return result;
}

function recordAliases(record, fieldName) {
    const result = aliases(record.getCellValue(fieldName));
    if (record.id) result.add(`id:${record.id}`);
    if (record.name) result.add(`name:${normalized(record.name)}`);
    return result;
}

function rehearsalKeys(record) {
    const result = new Set();
    if (record.id) result.add(`id:${record.id}`);
    if (record.name) result.add(`name:${normalized(record.name)}`);

    const date = dateKey(record.getCellValue("Rehearsal Date"));
    if (date) {
        result.add(`date:${date}`);
        result.add(`name:${normalized(displayDate(date))}`);
    }
    return result;
}

function absenceStatus(value) {
    const type = normalized(value);
    if (type.includes("excus")) return "Excused";
    if (type.includes("tardy") || type.includes("late")) return "Tardy";
    if (type.includes("early") || type.includes("dismiss")) return "Leaving Early";
    return "Absent";
}

const rehearsalQuery = await rehearsalsTable.selectRecordsAsync({
    fields: ["Rehearsal Date", "Ensemble(s)"]
});

const ensembleOptions = [];
const seenEnsembleIds = new Set();
for (const rehearsal of rehearsalQuery.records) {
    for (const ensemble of values(rehearsal.getCellValue("Ensemble(s)"))) {
        if (ensemble?.id && ensemble.name && !seenEnsembleIds.has(ensemble.id)) {
            seenEnsembleIds.add(ensemble.id);
            ensembleOptions.push({ id: ensemble.id, name: ensemble.name });
        }
    }
}

ensembleOptions.sort((a, b) => a.name.localeCompare(b.name));

if (ensembleOptions.length === 0) {
    output.text("❌ No ensembles were found in the rehearsal table.");
} else {
    const selectedEnsembleName = await input.buttonsAsync(
        "Select the ensemble:",
        ensembleOptions.map(option => option.name)
    );
    const selectedEnsemble = ensembleOptions.find(option => option.name === selectedEnsembleName);

    if (!selectedEnsemble) {
        output.text("❌ No ensemble was selected.");
    } else {
        // Do not group rehearsals by calendar date. Each record remains distinct.
        const columns = rehearsalQuery.records
            .filter(rehearsal => ids(rehearsal.getCellValue("Ensemble(s)"))
                .includes(selectedEnsemble.id))
            .map(rehearsal => ({
                record: rehearsal,
                id: rehearsal.id,
                date: dateKey(rehearsal.getCellValue("Rehearsal Date")),
                keys: rehearsalKeys(rehearsal)
            }))
            .filter(column => column.date)
            .sort((a, b) => a.date.localeCompare(b.date) || a.id.localeCompare(b.id));

        if (columns.length === 0) {
            output.text(`❌ No rehearsal dates found for ${selectedEnsembleName}.`);
        } else {
            const rosterQuery = await rostersTable.selectRecordsAsync({
                fields: [rosterPrimaryField, "Ensemble Registered"]
            });

            const ensembleKey = normalized(selectedEnsembleName);
            const students = rosterQuery.records
                .filter(record => values(record.getCellValue("Ensemble Registered"))
                    .some(ensemble => normalized(ensemble) === ensembleKey))
                .sort((a, b) => text(a.getCellValue(rosterPrimaryField))
                    .localeCompare(text(b.getCellValue(rosterPrimaryField))));

            const status = new Map();
            const setStatus = (studentKeys, rehearsalId, value) => {
                for (const studentKey of studentKeys) {
                    status.set(`${studentKey}|${rehearsalId}`, value);
                }
            };

            const attendanceQuery = await attendanceTable.selectRecordsAsync({
                fields: [attendanceDateField, attendanceStudentField]
            });

            for (const attendance of attendanceQuery.records) {
                const attendanceDateValue = attendance.getCellValue(attendanceDateField);
                const attendanceIds = new Set(ids(attendanceDateValue).map(id => `id:${id}`));
                const attendanceNames = new Set(values(attendanceDateValue)
                    .map(value => `name:${normalized(value)}`)
                    .filter(key => key !== "name:"));
                const attendanceDates = new Set(values(attendanceDateValue)
                    .map(value => dateKey(value))
                    .filter(Boolean)
                    .map(date => `date:${date}`));

                const matchingColumns = columns.filter(column =>
                    [...column.keys].some(key =>
                        attendanceIds.has(key) || attendanceNames.has(key) || attendanceDates.has(key)
                    )
                );

                if (matchingColumns.length === 0) continue;

                const studentKeys = aliases(attendance.getCellValue(attendanceStudentField));
                if (studentKeys.size === 0) continue;

                for (const column of matchingColumns) {
                    setStatus(studentKeys, column.id, "Present");
                }
            }

            const absenceQuery = await absencesTable.selectRecordsAsync({
                fields: [absenceStudentField, absenceDateField, absenceTypeField]
            });

            for (const absence of absenceQuery.records) {
                const studentKeys = aliases(absence.getCellValue(absenceStudentField));
                const absenceDateValue = absence.getCellValue(absenceDateField);
                const absenceIds = new Set(ids(absenceDateValue).map(id => `id:${id}`));
                const absenceNames = new Set(values(absenceDateValue)
                    .map(value => `name:${normalized(value)}`)
                    .filter(key => key !== "name:"));
                const absenceDates = new Set(values(absenceDateValue)
                    .map(value => dateKey(value))
                    .filter(Boolean)
                    .map(date => `date:${date}`));

                if (studentKeys.size === 0) continue;

                const matchingColumns = columns.filter(column =>
                    [...column.keys].some(key =>
                        absenceIds.has(key) || absenceNames.has(key) || absenceDates.has(key)
                    )
                );

                for (const column of matchingColumns) {
                    const key = [...studentKeys][0];
                    if (!status.has(`${key}|${column.id}`)) {
                        setStatus(studentKeys, column.id, absenceStatus(absence.getCellValue(absenceTypeField)));
                    }
                }
            }

            const usedHeaders = new Set();
            const rows = students.map(student => {
                const row = { "Student Name": text(student.getCellValue(rosterPrimaryField)) || student.name };
                const studentKeys = recordAliases(student, rosterPrimaryField);

                for (const column of columns) {
                    let value = "";
                    for (const studentKey of studentKeys) {
                        value = status.get(`${studentKey}|${column.id}`);
                        if (value) break;
                    }

                    const baseHeader = displayDate(column.date);
                    let header = baseHeader;
                    if (usedHeaders.has(header)) header = `${baseHeader} (${column.id.slice(-4)})`;
                    usedHeaders.add(header);
                    row[header] = value || "";
                }
                return row;
            });

            output.text(`## ${selectedEnsembleName}`);
            output.table(rows);
        }
    }
}
