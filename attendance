// Airtable Script: Spreadsheet-style attendance report with ensemble-first and date-second selectors
const REFRESH_INTERVAL_MS = 60000;

const rostersTable = base.getTable("Ensemble Rosters");
const rehearsalsTable = base.getTable("Rehearsals/Concerts");
const attendanceTable = base.getTable("Attendance");
const absencesTable = base.getTable("Absence Requests");

const rosterPrimaryField = "Student";
const arrivalTimeField = "Tardy Arrival Time";
const attendanceDateField = "Date of Attendance";
const attendanceStudentField = "Student";
const attendanceEnsembleField = "Ensemble";

function dateKey(value) {
    if (!value) return null;
    if (value instanceof Date) {
        return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, "0")}-${String(value.getDate()).padStart(2, "0")}`;
    }
    const match = String(value).match(/(\d{4})-(\d{2})-(\d{2})/);
    return match ? `${match[1]}-${match[2]}-${match[3]}` : null;
}

function linkedValues(value) {
    if (!value) return [];
    return Array.isArray(value) ? value : [value];
}

function linkedName(value) {
    if (!value) return "";
    if (typeof value === "string") return value.trim().toLowerCase();
    return String(value.name || value.value || "").trim().toLowerCase();
}

function linkedIds(value) {
    return linkedValues(value).map(item => item?.id).filter(Boolean);
}

function getStudentName(record) {
    const value = record.getCellValue(rosterPrimaryField);
    if (!value) return "Unnamed Student";
    if (typeof value === "string") return value.trim();
    if (Array.isArray(value)) return (value[0]?.name || String(value[0])).trim();
    return String(value.name || value).trim();
}

function formatTime(value) {
    if (!value) return "";
    const match = String(value).match(/T(\d{2}):(\d{2})/);
    if (!match) return String(value);
    let hour = parseInt(match[1], 10);
    const ampm = hour >= 12 ? "PM" : "AM";
    hour = hour % 12 || 12;
    return `${hour}:${match[2]} ${ampm}`;
}

function absenceMatchesRehearsal(record, rehearsalId, rehearsalDateKey) {
    const value = record.getCellValue("Absence Date");
    return linkedIds(value).includes(rehearsalId) || dateKey(value) === rehearsalDateKey;
}

function displayDate(key) {
    const [year, month, day] = key.split("-").map(Number);
    return new Date(year, month - 1, day).toLocaleDateString();
}

const rehearsalQuery = await rehearsalsTable.selectRecordsAsync({
    fields: ["Rehearsal Date", "Ensemble(s)"]
});

// Select the ensemble first from every ensemble represented in the rehearsal table.
const ensembleOptions = [];
const seenEnsembleIds = new Set();

for (const rehearsal of rehearsalQuery.records) {
    for (const ensemble of linkedValues(rehearsal.getCellValue("Ensemble(s)"))) {
        if (ensemble?.id && ensemble.name && !seenEnsembleIds.has(ensemble.id)) {
            seenEnsembleIds.add(ensemble.id);
            ensembleOptions.push({ id: ensemble.id, name: ensemble.name });
        }
    }
}

ensembleOptions.sort((a, b) => a.name.localeCompare(b.name));

if (ensembleOptions.length === 0) {
    output.text("❌ No ensembles were found in the rehearsal table.");
} else {
    const selectedEnsembleName = await input.buttonsAsync(
        "Select the ensemble first:",
        ensembleOptions.map(option => option.name)
    );

    const selectedEnsemble = ensembleOptions.find(
        option => option.name === selectedEnsembleName
    );

    if (!selectedEnsemble) {
        output.text("❌ No ensemble was selected.");
    } else {
        // Only show dates on which the selected ensemble actually rehearsed.
        const ensembleRehearsals = rehearsalQuery.records.filter(rehearsal =>
            linkedIds(rehearsal.getCellValue("Ensemble(s)"))
                .includes(selectedEnsemble.id)
        );

        const dateOptions = [...new Set(
            ensembleRehearsals
                .map(rehearsal => dateKey(rehearsal.getCellValue("Rehearsal Date")))
                .filter(Boolean)
        )].sort((a, b) => b.localeCompare(a));

        if (dateOptions.length === 0) {
            output.text(`❌ No rehearsal dates found for ${selectedEnsembleName}.`);
        } else {
            const dateLabels = dateOptions.map(key => `${displayDate(key)} (${key})`);
            const selectedDateLabel = await input.buttonsAsync(
                `Select a rehearsal date for ${selectedEnsembleName}:`,
                dateLabels
            );

            const selectedDateIndex = dateLabels.indexOf(selectedDateLabel);
            const targetDateKey = dateOptions[selectedDateIndex];

            const selectedRehearsal = ensembleRehearsals.find(rehearsal =>
                dateKey(rehearsal.getCellValue("Rehearsal Date")) === targetDateKey
            );

            if (!selectedRehearsal) {
                output.text(`❌ Could not find a rehearsal for ${selectedEnsembleName} on ${targetDateKey}.`);
            } else {
                const selectedRehearsalId = selectedRehearsal.id;
                const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

                while (true) {
                    const rosterQuery = await rostersTable.selectRecordsAsync({
                        fields: [rosterPrimaryField, "Ensemble Registered"]
                    });

                    const groupStudents = rosterQuery.records
                        .filter(student => linkedValues(student.getCellValue("Ensemble Registered"))
                            .some(group => linkedName(group) === selectedEnsembleName.trim().toLowerCase()))
                        .sort((a, b) => getStudentName(a).localeCompare(getStudentName(b)));

                    const attendanceQuery = await attendanceTable.selectRecordsAsync({
                        fields: [attendanceDateField, attendanceStudentField, attendanceEnsembleField]
                    });

                    const checkinRecords = attendanceQuery.records.filter(attendance =>
                        dateKey(attendance.getCellValue(attendanceDateField)) === targetDateKey &&
                        linkedIds(attendance.getCellValue(attendanceEnsembleField))
                            .includes(selectedEnsemble.id)
                    );

                    const checkedInIds = new Set();
                    const checkedInNames = new Set();

                    for (const attendance of checkinRecords) {
                        for (const student of linkedValues(
                            attendance.getCellValue(attendanceStudentField)
                        )) {
                            if (student?.id) checkedInIds.add(student.id);
                            const name = linkedName(student);
                            if (name) checkedInNames.add(name);
                        }
                    }

                    const absenceQuery = await absencesTable.selectRecordsAsync({
                        fields: ["Student Name", "Absence Date", "Absence Type", arrivalTimeField]
                    });
                    const absencesById = new Map();
                    const absencesByName = new Map();

                    for (const absence of absenceQuery.records) {
                        if (!absenceMatchesRehearsal(absence, selectedRehearsalId, targetDateKey)) continue;

                        const typeValue = absence.getCellValue("Absence Type");
                        const data = {
                            type: typeof typeValue === "string"
                                ? typeValue.trim()
                                : linkedName(typeValue) || "Absence",
                            time: formatTime(absence.getCellValue(arrivalTimeField))
                        };

                        for (const student of linkedValues(absence.getCellValue("Student Name"))) {
                            if (student?.id) absencesById.set(student.id, data);
                            const name = linkedName(student);
                            if (name) absencesByName.set(name, data);
                        }
                    }

                    const rows = [];
                    const counts = {
                        "Checked In": 0,
                        "Absent": 0,
                        "Tardy": 0,
                        "Leaving Early": 0,
                        "Missing": 0
                    };

                    for (const student of groupStudents) {
                        const name = getStudentName(student);
                        const nameKey = name.toLowerCase();
                        const absence = absencesById.get(student.id) || absencesByName.get(nameKey);
                        let status = "Missing";
                        let details = "No check-in or absence request found";
                        let expectedArrival = "";

                        if (checkedInIds.has(student.id) || checkedInNames.has(nameKey)) {
                            status = "Checked In";
                            details = "Attendance recorded";
                        } else if (absence) {
                            if (absence.type.toLowerCase() === "tardiness") {
                                status = "Tardy";
                                details = "Tardiness reported";
                                expectedArrival = absence.time;
                            } else if (absence.type.toLowerCase() === "early dismissal") {
                                status = "Leaving Early";
                                details = "Early dismissal reported";
                            } else {
                                status = "Absent";
                                details = absence.type;
                            }
                        }

                        counts[status]++;
                        rows.push({
                            Student: name,
                            Status: status,
                            Details: details,
                            "Expected Arrival": expectedArrival
                        });
                    }

                    output.clear();
                    output.markdown(`## Attendance Spreadsheet: ${selectedEnsembleName}`);
                    output.text(`Rehearsal Date: ${targetDateKey} | Last Updated: ${new Date().toLocaleTimeString()}`);
                    output.text(
                        `📊 ${counts["Checked In"]} Checked In | ${counts.Absent} Absent | ` +
                        `${counts.Tardy} Tardy | ${counts["Leaving Early"]} Leaving Early | ${counts.Missing} Missing`
                    );
                    output.table(rows);

                    await sleep(REFRESH_INTERVAL_MS);
                }
            }
        }
    }
}
