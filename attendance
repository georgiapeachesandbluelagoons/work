// Airtable Script: Attendance matrix with robust linked-student matching
const rostersTable = base.getTable("Ensemble Rosters");
const rehearsalsTable = base.getTable("Rehearsals/Concerts");
const attendanceTable = base.getTable("Attendance");
const absencesTable = base.getTable("Absence Requests");

const rosterPrimaryField = "Student";
const attendanceDateField = "Date of Attendance";
const attendanceStudentField = "Student";
const attendanceEnsembleField = "Ensemble";
const absenceDateField = "Absence Date";
const absenceStudentField = "Student Name";
const absenceTypeField = "Absence Type";
const tardyArrivalField = "Tardy Arrival Time";

function linkedValues(value) {
    if (!value) return [];
    return Array.isArray(value) ? value : [value];
}

function valueText(value) {
    if (value == null) return "";
    if (typeof value === "string" || typeof value === "number") return String(value).trim();
    return String(value.name || value.value || value.text || "").trim();
}

function normalizedName(value) {
    return valueText(value).toLowerCase().replace(/\s+/g, " ");
}

function linkedIds(value) {
    return linkedValues(value).map(item => item?.id).filter(Boolean);
}

function linkedNames(value) {
    return linkedValues(value).map(normalizedName).filter(Boolean);
}

function dateKey(value) {
    if (!value) return null;
    if (value instanceof Date) {
        return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, "0")}-${String(value.getDate()).padStart(2, "0")}`;
    }

    const text = String(value);
    const isoMatch = text.match(/(\d{4})-(\d{2})-(\d{2})/);
    if (isoMatch) return `${isoMatch[1]}-${isoMatch[2]}-${isoMatch[3]}`;

    const usMatch = text.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
    if (usMatch) {
        return `${usMatch[3]}-${String(usMatch[1]).padStart(2, "0")}-${String(usMatch[2]).padStart(2, "0")}`;
    }

    return null;
}

function displayDate(key) {
    const [year, month, day] = key.split("-").map(Number);
    return `${month}/${day}/${year}`;
}

function getStudentName(record) {
    const value = record.getCellValue(rosterPrimaryField);
    const firstValue = linkedValues(value)[0];
    return valueText(firstValue) || record.name || "Unnamed Student";
}

// Creates every identifier that could represent the same student. This supports:
// - Attendance.Student linking directly to the roster record
// - Attendance.Student linking to the underlying student record
// - lookup/text-style student values containing only a name
function studentAliases(record, fieldName) {
    const aliases = new Set();
    if (record?.id) aliases.add(`id:${record.id}`);

    for (const value of linkedValues(record?.getCellValue(fieldName))) {
        if (value?.id) aliases.add(`id:${value.id}`);
        const name = normalizedName(value);
        if (name) aliases.add(`name:${name}`);
    }

    const recordName = normalizedName(record?.name);
    if (recordName) aliases.add(`name:${recordName}`);
    return aliases;
}

function aliasKeysFromValue(value) {
    const keys = [];
    for (const item of linkedValues(value)) {
        if (item?.id) keys.push(`id:${item.id}`);
        const name = normalizedName(item);
        if (name) keys.push(`name:${name}`);
    }
    return keys;
}

function normalizeAbsenceType(value) {
    const text = valueText(value).toLowerCase();
    if (text.includes("excus")) return "Excused";
    if (text.includes("tardy") || text.includes("late")) return "Tardy";
    if (text.includes("early") || text.includes("dismiss")) return "Leaving Early";
    return "Absent";
}

function absenceMatchesDate(record, rehearsalId, rehearsalDate) {
    const value = record.getCellValue(absenceDateField);
    return linkedIds(value).includes(rehearsalId) || dateKey(value) === rehearsalDate;
}

const rehearsalQuery = await rehearsalsTable.selectRecordsAsync({
    fields: ["Rehearsal Date", "Ensemble(s)"]
});

const rehearsalInfoById = new Map();
const ensembleOptions = [];
const seenEnsembleIds = new Set();

for (const rehearsal of rehearsalQuery.records) {
    const date = dateKey(rehearsal.getCellValue("Rehearsal Date"));
    rehearsalInfoById.set(rehearsal.id, { date });

    for (const ensemble of linkedValues(rehearsal.getCellValue("Ensemble(s)"))) {
        if (ensemble?.id && ensemble.name && !seenEnsembleIds.has(ensemble.id)) {
            seenEnsembleIds.add(ensemble.id);
            ensembleOptions.push({ id: ensemble.id, name: ensemble.name });
        }
    }
}

ensembleOptions.sort((a, b) => a.name.localeCompare(b.name));

if (ensembleOptions.length === 0) {
    output.text("❌ No ensembles were found in the rehearsal table.");
} else {
    const selectedEnsembleName = await input.buttonsAsync(
        "Select the ensemble:",
        ensembleOptions.map(option => option.name)
    );
    const selectedEnsemble = ensembleOptions.find(option => option.name === selectedEnsembleName);

    if (!selectedEnsemble) {
        output.text("❌ No ensemble was selected.");
    } else {
        const ensembleRehearsals = rehearsalQuery.records.filter(rehearsal =>
            linkedIds(rehearsal.getCellValue("Ensemble(s)"))
                .includes(selectedEnsemble.id)
        );
        const selectedRehearsalIds = new Set(ensembleRehearsals.map(record => record.id));
        const dateOptions = [...new Set(
            ensembleRehearsals.map(record => dateKey(record.getCellValue("Rehearsal Date"))).filter(Boolean)
        )].sort((a, b) => a.localeCompare(b));

        if (dateOptions.length === 0) {
            output.text(`❌ No rehearsal dates found for ${selectedEnsembleName}.`);
        } else {
            const rosterQuery = await rostersTable.selectRecordsAsync({
                fields: [rosterPrimaryField, "Ensemble Registered"]
            });

            const students = rosterQuery.records
                .filter(record => linkedNames(record.getCellValue("Ensemble Registered"))
                    .includes(normalizedName(selectedEnsembleName)))
                .sort((a, b) => getStudentName(a).localeCompare(getStudentName(b)));

            const statusByAliasAndDate = new Map();
            const setStatus = (aliases, date, status) => {
                for (const alias of aliases) {
                    statusByAliasAndDate.set(`${alias}|${date}`, status);
                }
            };

            const attendanceQuery = await attendanceTable.selectRecordsAsync({
                fields: [attendanceDateField, attendanceStudentField, attendanceEnsembleField]
            });

            for (const attendance of attendanceQuery.records) {
                const matchedDates = linkedIds(attendance.getCellValue(attendanceDateField))
                    .filter(id => selectedRehearsalIds.has(id))
                    .map(id => rehearsalInfoById.get(id)?.date)
                    .filter(date => date && dateOptions.includes(date));

                if (matchedDates.length === 0) continue;

                const attendanceStudentAliases = aliasKeysFromValue(
                    attendance.getCellValue(attendanceStudentField)
                );
                if (attendanceStudentAliases.length === 0) continue;

                for (const date of matchedDates) {
                    setStatus(attendanceStudentAliases, date, "Present");
                }
            }

            const absenceQuery = await absencesTable.selectRecordsAsync({
                fields: [absenceStudentField, absenceDateField, absenceTypeField, tardyArrivalField]
            });

            for (const absence of absenceQuery.records) {
                const status = normalizeAbsenceType(absence.getCellValue(absenceTypeField));
                const aliases = aliasKeysFromValue(absence.getCellValue(absenceStudentField));

                if (aliases.length === 0) continue;

                for (const rehearsal of ensembleRehearsals) {
                    const date = dateKey(rehearsal.getCellValue("Rehearsal Date"));
                    if (!date || !absenceMatchesDate(absence, rehearsal.id, date)) continue;
                    setStatus(aliases, date, status);
                }
            }

            const rows = students.map(student => {
                const row = { "Student Name": getStudentName(student) };
                const aliases = studentAliases(student, rosterPrimaryField);

                for (const date of dateOptions) {
                    let status = "";
                    for (const alias of aliases) {
                        status = statusByAliasAndDate.get(`${alias}|${date}`);
                        if (status) break;
                    }
                    row[displayDate(date)] = status || "";
                }

                return row;
            });

            output.text(`## ${selectedEnsembleName}`);
            output.table(rows);
        }
    }
}
