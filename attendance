// Airtable Script: Attendance matrix matching the spreadsheet screenshot
const rostersTable = base.getTable("Ensemble Rosters");
const rehearsalsTable = base.getTable("Rehearsals/Concerts");
const attendanceTable = base.getTable("Attendance");
const absencesTable = base.getTable("Absence Requests");

const rosterPrimaryField = "Student";
const attendanceDateField = "Date of Attendance";
const attendanceStudentField = "Student";
const attendanceEnsembleField = "Ensemble";
const absenceDateField = "Absence Date";
const absenceStudentField = "Student Name";
const absenceTypeField = "Absence Type";
const tardyArrivalField = "Tardy Arrival Time";

function linkedValues(value) {
    if (!value) return [];
    return Array.isArray(value) ? value : [value];
}

function linkedIds(value) {
    return linkedValues(value).map(item => item?.id).filter(Boolean);
}

function linkedName(value) {
    if (!value) return "";
    if (typeof value === "string") return value.trim().toLowerCase();
    return String(value.name || value.value || "").trim().toLowerCase();
}

function dateKey(value) {
    if (!value) return null;
    if (value instanceof Date) {
        return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, "0")}-${String(value.getDate()).padStart(2, "0")}`;
    }
    const match = String(value).match(/(\d{4})-(\d{2})-(\d{2})/);
    return match ? `${match[1]}-${match[2]}-${match[3]}` : null;
}

function displayDate(dateKeyValue) {
    if (!dateKeyValue) return "";
    const [year, month, day] = dateKeyValue.split("-").map(Number);
    return new Date(year, month - 1, day).toLocaleDateString("en-US");
}

function getStudentName(record) {
    const value = record.getCellValue(rosterPrimaryField);
    if (!value) return "Unnamed Student";
    if (typeof value === "string") return value.trim();
    if (Array.isArray(value)) return (value[0]?.name || String(value[0])).trim();
    return String(value.name || value).trim();
}

function formatTime(value) {
    if (!value) return "";
    const match = String(value).match(/T(\d{2}):(\d{2})/);
    if (!match) return String(value);
    let hour = parseInt(match[1], 10);
    const ampm = hour >= 12 ? "PM" : "AM";
    hour = hour % 12 || 12;
    return `${hour}:${match[2]} ${ampm}`;
}

function normalizeAbsenceType(value) {
    if (!value) return "Absent";
    const text = typeof value === "string"
        ? value.trim()
        : String(value.name || value.value || "").trim();
    const lower = text.toLowerCase();

    if (lower.includes("tardy") || lower.includes("late")) return "Tardy";
    if (lower.includes("early") || lower.includes("dismiss")) return "Leaving Early";
    if (lower.includes("excus")) return "Excused";
    return "Absent";
}

function absenceMatchesRehearsal(record, rehearsalId, rehearsalDateKey) {
    const value = record.getCellValue(absenceDateField);
    if (!value) return false;

    const ids = linkedIds(value);
    if (ids.includes(rehearsalId)) return true;

    return dateKey(value) === rehearsalDateKey;
}

const rehearsalQuery = await rehearsalsTable.selectRecordsAsync({
    fields: ["Rehearsal Date", "Ensemble(s)"]
});

const ensembleOptions = [];
const seenEnsembleIds = new Set();

for (const rehearsal of rehearsalQuery.records) {
    for (const ensemble of linkedValues(rehearsal.getCellValue("Ensemble(s)"))) {
        if (ensemble?.id && ensemble.name && !seenEnsembleIds.has(ensemble.id)) {
            seenEnsembleIds.add(ensemble.id);
            ensembleOptions.push({ id: ensemble.id, name: ensemble.name });
        }
    }
}

ensembleOptions.sort((a, b) => a.name.localeCompare(b.name));

if (ensembleOptions.length === 0) {
    output.text("❌ No ensembles were found in the rehearsal table.");
} else {
    const selectedEnsembleName = await input.buttonsAsync(
        "Select the ensemble:",
        ensembleOptions.map(option => option.name)
    );

    const selectedEnsemble = ensembleOptions.find(
        option => option.name === selectedEnsembleName
    );

    if (!selectedEnsemble) {
        output.text("❌ No ensemble was selected.");
    } else {
        const ensembleRehearsals = rehearsalQuery.records.filter(rehearsal =>
            linkedIds(rehearsal.getCellValue("Ensemble(s)"))
                .includes(selectedEnsemble.id)
        );

        const dateOptions = [...new Set(
            ensembleRehearsals
                .map(rehearsal => dateKey(rehearsal.getCellValue("Rehearsal Date")))
                .filter(Boolean)
        )].sort((a, b) => a.localeCompare(b));

        if (dateOptions.length === 0) {
            output.text(`❌ No rehearsal dates found for ${selectedEnsembleName}.`);
        } else {
            const rosterQuery = await rostersTable.selectRecordsAsync({
                fields: [rosterPrimaryField, "Ensemble Registered"]
            });

            const groupStudents = rosterQuery.records
                .filter(student => linkedValues(student.getCellValue("Ensemble Registered"))
                    .some(group => linkedName(group) === selectedEnsembleName.trim().toLowerCase()))
                .sort((a, b) => getStudentName(a).localeCompare(getStudentName(b)));

            const attendanceByStudentDate = new Map();
            const attendanceQuery = await attendanceTable.selectRecordsAsync({
                fields: [attendanceDateField, attendanceStudentField, attendanceEnsembleField]
            });

            for (const attendance of attendanceQuery.records) {
                const attendanceDate = dateKey(attendance.getCellValue(attendanceDateField));
                const ensembleIds = linkedIds(attendance.getCellValue(attendanceEnsembleField));

                if (!attendanceDate || !dateOptions.includes(attendanceDate)) continue;
                if (!ensembleIds.includes(selectedEnsemble.id)) continue;

                for (const student of linkedValues(attendance.getCellValue(attendanceStudentField))) {
                    if (student?.id) {
                        attendanceByStudentDate.set(`${student.id}|${attendanceDate}`, "Present");
                    }
                }
            }

            const absenceByStudentDate = new Map();
            const absenceQuery = await absencesTable.selectRecordsAsync({
                fields: [absenceStudentField, absenceDateField, absenceTypeField, tardyArrivalField]
            });

            for (const absence of absenceQuery.records) {
                for (const rehearsal of ensembleRehearsals) {
                    const rehearsalDate = dateKey(rehearsal.getCellValue("Rehearsal Date"));
                    if (!rehearsalDate || !dateOptions.includes(rehearsalDate)) continue;

                    if (!absenceMatchesRehearsal(absence, rehearsal.id, rehearsalDate)) continue;

                    const normalizedType = normalizeAbsenceType(absence.getCellValue(absenceTypeField));
                    const arrivalTime = formatTime(absence.getCellValue(tardyArrivalField));

                    for (const student of linkedValues(absence.getCellValue(absenceStudentField))) {
                        if (!student?.id) continue;
                        const key = `${student.id}|${rehearsalDate}`;

                        if (normalizedType === "Tardy") {
                            absenceByStudentDate.set(key, { status: "Tardy", time: arrivalTime });
                        } else if (normalizedType === "Leaving Early") {
                            absenceByStudentDate.set(key, { status: "Leaving Early", time: "" });
                        } else if (normalizedType === "Excused") {
                            absenceByStudentDate.set(key, { status: "Excused", time: "" });
                        } else {
                            absenceByStudentDate.set(key, { status: "Absent", time: "" });
                        }
                    }
                }
            }

            const rows = [];

            for (const student of groupStudents) {
                const row = { "Student Name": getStudentName(student) };

                for (const date of dateOptions) {
                    const key = `${student.id}|${date}`;
                    const checkedIn = attendanceByStudentDate.get(key);
                    const absence = absenceByStudentDate.get(key);

                    if (checkedIn) {
                        row[displayDate(date)] = "Present";
                    } else if (absence) {
                        row[displayDate(date)] = absence.status;
                    } else {
                        row[displayDate(date)] = "Missing";
                    }
                }

                rows.push(row);
            }

            output.text(`## ${selectedEnsembleName}`);
            output.table(rows);
        }
    }
}
