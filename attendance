// Airtable Script: Attendance matrix keyed by exact rehearsal record and robust student aliases
const rostersTable = base.getTable("Ensemble Rosters");
const rehearsalsTable = base.getTable("Rehearsals/Concerts");
const attendanceTable = base.getTable("Attendance");
const absencesTable = base.getTable("Absence Requests");

const rosterPrimaryField = "Student";
const attendanceDateField = "Date of Attendance"; // Link to Rehearsals/Concerts
const attendanceStudentField = "Student";
const absenceDateField = "Absence Date"; // Link to Rehearsals/Concerts
const absenceStudentField = "Student Name";
const absenceTypeField = "Absence Type";

function values(value) {
    if (!value) return [];
    return Array.isArray(value) ? value : [value];
}

function text(value) {
    if (value == null) return "";
    if (typeof value === "string" || typeof value === "number") return String(value).trim();
    return String(value.name || value.value || value.text || "").trim();
}

function nameKey(value) {
    return text(value).toLowerCase().replace(/\s+/g, " ");
}

function ids(value) {
    return values(value).map(value => value?.id).filter(Boolean);
}

function aliasKeys(value) {
    const result = [];
    for (const item of values(value)) {
        if (item?.id) result.push(`id:${item.id}`);
        const name = nameKey(item);
        if (name) result.push(`name:${name}`);
    }
    return result;
}

function dateKey(value) {
    if (!value) return null;
    if (value instanceof Date) {
        return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, "0")}-${String(value.getDate()).padStart(2, "0")}`;
    }
    const valueText = String(value);
    const iso = valueText.match(/(\d{4})-(\d{2})-(\d{2})/);
    if (iso) return `${iso[1]}-${iso[2]}-${iso[3]}`;
    const us = valueText.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
    return us ? `${us[3]}-${String(us[1]).padStart(2, "0")}-${String(us[2]).padStart(2, "0")}` : null;
}

function displayDate(key) {
    const [year, month, day] = key.split("-").map(Number);
    return `${month}/${day}/${year}`;
}

function studentName(record) {
    const linkedStudent = values(record.getCellValue(rosterPrimaryField))[0];
    return text(linkedStudent) || record.name || "Unnamed Student";
}

function rosterAliases(record) {
    const result = new Set();
    if (record.id) result.add(`id:${record.id}`);
    for (const key of aliasKeys(record.getCellValue(rosterPrimaryField))) result.add(key);
    if (record.name) result.add(`name:${nameKey(record.name)}`);
    return result;
}

function absenceStatus(value) {
    const lower = text(value).toLowerCase();
    if (lower.includes("excus")) return "Excused";
    if (lower.includes("tardy") || lower.includes("late")) return "Tardy";
    if (lower.includes("early") || lower.includes("dismiss")) return "Leaving Early";
    return "Absent";
}

const rehearsalQuery = await rehearsalsTable.selectRecordsAsync({
    fields: ["Rehearsal Date", "Ensemble(s)"]
});

const ensembles = [];
const seenEnsembleIds = new Set();
for (const rehearsal of rehearsalQuery.records) {
    for (const ensemble of values(rehearsal.getCellValue("Ensemble(s)"))) {
        if (ensemble?.id && ensemble.name && !seenEnsembleIds.has(ensemble.id)) {
            seenEnsembleIds.add(ensemble.id);
            ensembles.push({ id: ensemble.id, name: ensemble.name });
        }
    }
}

ensembles.sort((a, b) => a.name.localeCompare(b.name));

if (ensembles.length === 0) {
    output.text("❌ No ensembles were found in the rehearsal table.");
} else {
    const selectedEnsembleName = await input.buttonsAsync(
        "Select the ensemble:",
        ensembles.map(ensemble => ensemble.name)
    );
    const selectedEnsemble = ensembles.find(ensemble => ensemble.name === selectedEnsembleName);

    if (!selectedEnsemble) {
        output.text("❌ No ensemble was selected.");
    } else {
        // Keep each rehearsal record separate. Do not deduplicate by calendar date.
        const columns = rehearsalQuery.records
            .filter(rehearsal => ids(rehearsal.getCellValue("Ensemble(s)"))
                .includes(selectedEnsemble.id))
            .map(rehearsal => ({
                id: rehearsal.id,
                date: dateKey(rehearsal.getCellValue("Rehearsal Date"))
            }))
            .filter(column => column.date)
            .sort((a, b) => a.date.localeCompare(b.date) || a.id.localeCompare(b.id));

        if (columns.length === 0) {
            output.text(`❌ No rehearsal dates found for ${selectedEnsembleName}.`);
        } else {
            const rosterQuery = await rostersTable.selectRecordsAsync({
                fields: [rosterPrimaryField, "Ensemble Registered"]
            });
            const ensembleNameKey = nameKey(selectedEnsembleName);
            const students = rosterQuery.records
                .filter(record => values(record.getCellValue("Ensemble Registered"))
                    .some(ensemble => nameKey(ensemble) === ensembleNameKey))
                .sort((a, b) => studentName(a).localeCompare(studentName(b)));

            const status = new Map();
            const setStatus = (aliases, rehearsalId, value) => {
                for (const alias of aliases) {
                    status.set(`${alias}|${rehearsalId}`, value);
                }
            };

            const attendanceQuery = await attendanceTable.selectRecordsAsync({
                fields: [attendanceDateField, attendanceStudentField]
            });

            for (const attendance of attendanceQuery.records) {
                // The linked rehearsal ID is the authoritative date/ensemble match.
                const rehearsalIds = ids(attendance.getCellValue(attendanceDateField));
                const relevantRehearsalIds = rehearsalIds.filter(id => columns.some(column => column.id === id));
                if (relevantRehearsalIds.length === 0) continue;

                const studentAliases = aliasKeys(attendance.getCellValue(attendanceStudentField));
                if (studentAliases.length === 0) continue;

                for (const rehearsalId of relevantRehearsalIds) {
                    setStatus(studentAliases, rehearsalId, "Present");
                }
            }

            const absenceQuery = await absencesTable.selectRecordsAsync({
                fields: [absenceStudentField, absenceDateField, absenceTypeField]
            });

            for (const absence of absenceQuery.records) {
                const studentAliases = aliasKeys(absence.getCellValue(absenceStudentField));
                if (studentAliases.length === 0) continue;

                const absenceRehearsalIds = ids(absence.getCellValue(absenceDateField));
                const matchingIds = absenceRehearsalIds.filter(id => columns.some(column => column.id === id));
                if (matchingIds.length === 0) continue;

                for (const rehearsalId of matchingIds) {
                    setStatus(studentAliases, rehearsalId, absenceStatus(absence.getCellValue(absenceTypeField)));
                }
            }

            const rows = students.map(student => {
                const row = { "Student Name": studentName(student) };
                const aliases = rosterAliases(student);

                for (const column of columns) {
                    let value = "";
                    for (const alias of aliases) {
                        value = status.get(`${alias}|${column.id}`);
                        if (value) break;
                    }
                    row[displayDate(column.date)] = value || "";
                }
                return row;
            });

            output.text(`## ${selectedEnsembleName}`);
            output.table(rows);
        }
    }
}
