// Airtable Script: Attendance matrix using the exact Airtable linked-record IDs
const rostersTable = base.getTable("Ensemble Rosters");
const rehearsalsTable = base.getTable("Rehearsals/Concerts");
const attendanceTable = base.getTable("Attendance");
const absencesTable = base.getTable("Absence Requests");

const ROSTER_STUDENT_FIELD = "Student";
const ROSTER_ENSEMBLE_FIELD = "Ensemble Registered";
const REHEARSAL_DATE_FIELD = "Rehearsal Date";
const REHEARSAL_ENSEMBLE_FIELD = "Ensemble(s)";
const ATTENDANCE_REHEARSAL_FIELD = "Date of Attendance";
const ATTENDANCE_STUDENT_FIELD = "Student";
const ABSENCE_REHEARSAL_FIELD = "Absence Date";
const ABSENCE_STUDENT_FIELD = "Student Name";
const ABSENCE_TYPE_FIELD = "Absence Type";

function linkedRecords(value) {
    if (!value) return [];
    return Array.isArray(value) ? value : [value];
}

function recordIds(value) {
    return new Set(linkedRecords(value).map(record => record?.id).filter(Boolean));
}

function recordNames(value) {
    return linkedRecords(value)
        .map(record => record?.name || record?.value || "")
        .filter(Boolean);
}

function dateKey(value) {
    if (!value) return null;
    if (value instanceof Date) {
        return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, "0")}-${String(value.getDate()).padStart(2, "0")}`;
    }

    const valueText = String(value);
    const iso = valueText.match(/(\d{4})-(\d{2})-(\d{2})/);
    if (iso) return `${iso[1]}-${iso[2]}-${iso[3]}`;

    const us = valueText.match(/(\d{1,2})\/(\d{1,2})\/(\d{4})/);
    if (us) return `${us[3]}-${String(us[1]).padStart(2, "0")}-${String(us[2]).padStart(2, "0")}`;

    return null;
}

function displayDate(key) {
    const [year, month, day] = key.split("-").map(Number);
    return `${month}/${day}/${year}`;
}

function normalized(value) {
    return String(value || "").trim().toLowerCase().replace(/\s+/g, " ");
}

function fieldNames(value) {
    return new Set(linkedRecords(value).map(record => normalized(record?.name || record?.value)));
}

function rosterStudentName(rosterRecord) {
    const studentLinks = linkedRecords(rosterRecord.getCellValue(ROSTER_STUDENT_FIELD));
    return studentLinks[0]?.name || rosterRecord.name || "Unnamed Student";
}

function absenceStatus(value) {
    const status = normalized(value?.name || value?.value || value);
    if (status.includes("excus")) return "Excused";
    if (status.includes("tardy") || status.includes("late")) return "Tardy";
    if (status.includes("early") || status.includes("dismiss")) return "Leaving Early";
    return "Absent";
}

// Load the exact rehearsal records. A rehearsal record is a column identity;
// its calendar date is only the label displayed to the user.
const rehearsalQuery = await rehearsalsTable.selectRecordsAsync({
    fields: [REHEARSAL_DATE_FIELD, REHEARSAL_ENSEMBLE_FIELD]
});

const ensembleOptions = [];
const ensembleById = new Map();

for (const rehearsal of rehearsalQuery.records) {
    for (const ensemble of linkedRecords(rehearsal.getCellValue(REHEARSAL_ENSEMBLE_FIELD))) {
        if (ensemble?.id && ensemble.name && !ensembleById.has(ensemble.id)) {
            const option = { id: ensemble.id, name: ensemble.name };
            ensembleById.set(ensemble.id, option);
            ensembleOptions.push(option);
        }
    }
}

ensembleOptions.sort((a, b) => a.name.localeCompare(b.name));

if (ensembleOptions.length === 0) {
    output.text("❌ No ensembles were found in Rehearsals/Concerts.");
} else {
    const selectedEnsembleName = await input.buttonsAsync(
        "Select the ensemble:",
        ensembleOptions.map(option => option.name)
    );
    const selectedEnsemble = ensembleOptions.find(option => option.name === selectedEnsembleName);

    if (!selectedEnsemble) {
        output.text("❌ No ensemble was selected.");
    } else {
        const columns = rehearsalQuery.records
            .filter(rehearsal => recordIds(rehearsal.getCellValue(REHEARSAL_ENSEMBLE_FIELD))
                .has(selectedEnsemble.id))
            .map(rehearsal => ({
                id: rehearsal.id,
                date: dateKey(rehearsal.getCellValue(REHEARSAL_DATE_FIELD))
            }))
            .filter(column => column.date)
            .sort((a, b) => a.date.localeCompare(b.date) || a.id.localeCompare(b.id));

        if (columns.length === 0) {
            output.text(`❌ No rehearsal records found for ${selectedEnsembleName}.`);
        } else {
            const rosterQuery = await rostersTable.selectRecordsAsync({
                fields: [ROSTER_STUDENT_FIELD, ROSTER_ENSEMBLE_FIELD]
            });

            const students = rosterQuery.records
                .filter(rosterRecord => recordIds(rosterRecord.getCellValue(ROSTER_ENSEMBLE_FIELD))
                    .has(selectedEnsemble.id))
                .sort((a, b) => rosterStudentName(a).localeCompare(rosterStudentName(b)));

            // The keys in this map are the actual Airtable IDs from:
            // Attendance.Student and Attendance.Date of Attendance.
            const statusByRosterAndRehearsal = new Map();

            const attendanceQuery = await attendanceTable.selectRecordsAsync({
                fields: [ATTENDANCE_REHEARSAL_FIELD, ATTENDANCE_STUDENT_FIELD]
            });

            let matchedAttendanceRecords = 0;
            for (const attendance of attendanceQuery.records) {
                const rehearsalIds = recordIds(attendance.getCellValue(ATTENDANCE_REHEARSAL_FIELD));
                const studentIds = recordIds(attendance.getCellValue(ATTENDANCE_STUDENT_FIELD));
                const matchingColumnIds = columns
                    .filter(column => rehearsalIds.has(column.id))
                    .map(column => column.id);

                if (matchingColumnIds.length === 0 || studentIds.size === 0) continue;
                matchedAttendanceRecords++;

                for (const studentId of studentIds) {
                    for (const rehearsalId of matchingColumnIds) {
                        statusByRosterAndRehearsal.set(`${studentId}|${rehearsalId}`, "Present");
                    }
                }
            }

            const absenceQuery = await absencesTable.selectRecordsAsync({
                fields: [ABSENCE_REHEARSAL_FIELD, ABSENCE_STUDENT_FIELD, ABSENCE_TYPE_FIELD]
            });

            for (const absence of absenceQuery.records) {
                const rehearsalIds = recordIds(absence.getCellValue(ABSENCE_REHEARSAL_FIELD));
                const studentIds = recordIds(absence.getCellValue(ABSENCE_STUDENT_FIELD));
                const status = absenceStatus(absence.getCellValue(ABSENCE_TYPE_FIELD));

                for (const studentId of studentIds) {
                    for (const column of columns) {
                        const key = `${studentId}|${column.id}`;
                        if (rehearsalIds.has(column.id) && !statusByRosterAndRehearsal.has(key)) {
                            statusByRosterAndRehearsal.set(key, status);
                        }
                    }
                }
            }

            // Airtable output.table uses object keys for columns. Add a short
            // record-ID suffix when two rehearsal records share the same date.
            const headers = columns.map((column, index) => {
                const dateHeader = displayDate(column.date);
                const duplicate = columns.slice(0, index).some(previous => previous.date === column.date);
                return duplicate ? `${dateHeader} (${column.id.slice(-4)})` : dateHeader;
            });

            const rows = students.map(rosterRecord => {
                const row = { "Student Name": rosterStudentName(rosterRecord) };

                for (let index = 0; index < columns.length; index++) {
                    const column = columns[index];
                    const value = statusByRosterAndRehearsal.get(`${rosterRecord.id}|${column.id}`) || "";
                    row[headers[index]] = value;
                }

                return row;
            });

            output.text(`## ${selectedEnsembleName}`);
            output.text(`${students.length} students | ${columns.length} rehearsal records | ${matchedAttendanceRecords} matching attendance records`);
            output.table(rows);
        }
    }
}
