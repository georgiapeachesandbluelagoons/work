const eventsTable = base.getTable("Rehearsals/Concerts");
const rostersTable = base.getTable("Ensemble Rosters");
const attendanceTable = base.getTable("Attendance");

const eventDateField = "Rehearsal Date";
const eventEnsembleField = "Ensemble(s)";
const rosterEnsembleField = "Ensemble Registered";
const attendanceField = "Attendance";
const absenceRequestsField = "Absence Requests";
const missedRehearsalsField = "Missed Rehearsals";

function getLinkedIds(record, fieldName) {
    const value = record.getCellValue(fieldName) || [];
    const values = Array.isArray(value) ? value : [value];

    return new Set(
        values
            .filter(function (item) {
                return item && item.id;
            })
            .map(function (item) {
                return item.id;
            })
    );
}

function getEventDateOnly(record) {
    const value = record.getCellValue(eventDateField);

    if (!value) {
        return null;
    }

    return String(value).slice(0, 10);
}

function findLinkField(table, linkedTableId, fieldToExclude) {
    const matches = table.fields.filter(function (field) {
        return (
            field.name !== fieldToExclude &&
            field.type === "multipleRecordLinks" &&
            field.options &&
            field.options.linkedTableId === linkedTableId
        );
    });

    if (matches.length !== 1) {
        const names = matches.map(function (field) {
            return field.name;
        }).join(", ");

        throw new Error(
            "Expected exactly one link field in the Attendance table to " +
            "Rehearsals/Concerts and one to Ensemble Rosters. Found event " +
            "link candidates: " + names
        );
    }

    return matches[0].name;
}

const attendanceEventField = findLinkField(
    attendanceTable,
    eventsTable.id,
    null
);

const attendanceRosterField = findLinkField(
    attendanceTable,
    rostersTable.id,
    attendanceEventField
);

const eventsQuery = await eventsTable.selectRecordsAsync({
    fields: [eventDateField, eventEnsembleField]
});

const rostersQuery = await rostersTable.selectRecordsAsync({
    fields: [
        rosterEnsembleField,
        attendanceField,
        absenceRequestsField,
        missedRehearsalsField
    ]
});

const attendanceQuery = await attendanceTable.selectRecordsAsync({
    fields: [attendanceEventField, attendanceRosterField]
});

const easternToday = new Intl.DateTimeFormat("en-CA", {
    timeZone: "America/New_York",
    year: "numeric",
    month: "2-digit",
    day: "2-digit"
}).format(new Date());

const attendanceEventsByRoster = new Map();

// Build a map from each roster record to the rehearsal/concert records
// represented by that student's Attendance records.
for (const attendanceRecord of attendanceQuery.records) {
    const rosterIds = getLinkedIds(
        attendanceRecord,
        attendanceRosterField
    );
    const eventIds = getLinkedIds(
        attendanceRecord,
        attendanceEventField
    );

    for (const rosterId of rosterIds) {
        if (!attendanceEventsByRoster.has(rosterId)) {
            attendanceEventsByRoster.set(rosterId, new Set());
        }

        const rosterEventIds = attendanceEventsByRoster.get(rosterId);

        for (const eventId of eventIds) {
            rosterEventIds.add(eventId);
        }
    }
}

const rosterDetails = new Map();

for (const rosterRecord of rostersQuery.records) {
    const attendanceRecordIds = getLinkedIds(
        rosterRecord,
        attendanceField
    );
    const absenceRequestEventIds = getLinkedIds(
        rosterRecord,
        absenceRequestsField
    );
    const attendanceEventIds = new Set(
        attendanceEventsByRoster.get(rosterRecord.id) || []
    );

    // Also follow the Attendance links present directly on this roster record.
    // This covers cases where the Attendance table's roster link is a lookup
    // or is not populated consistently.
    for (const attendanceRecordId of attendanceRecordIds) {
        const attendanceRecord = attendanceQuery.records.find(function (record) {
            return record.id === attendanceRecordId;
        });

        if (!attendanceRecord) {
            continue;
        }

        const eventIds = getLinkedIds(
            attendanceRecord,
            attendanceEventField
        );

        for (const eventId of eventIds) {
            attendanceEventIds.add(eventId);
        }
    }

    rosterDetails.set(rosterRecord.id, {
        ensembleIds: getLinkedIds(rosterRecord, rosterEnsembleField),
        accountedForEventIds: new Set([
            ...attendanceEventIds,
            ...absenceRequestEventIds
        ]),
        missedEventIds: new Set()
    });
}

for (const eventRecord of eventsQuery.records) {
    const eventDate = getEventDateOnly(eventRecord);

    if (!eventDate || eventDate > easternToday) {
        continue;
    }

    const eventEnsembleIds = getLinkedIds(
        eventRecord,
        eventEnsembleField
    );

    if (eventEnsembleIds.size === 0) {
        continue;
    }

    for (const roster of rosterDetails.values()) {
        const sameEnsemble = Array.from(eventEnsembleIds).some(
            function (ensembleId) {
                return roster.ensembleIds.has(ensembleId);
            }
        );

        if (!sameEnsemble) {
            continue;
        }

        if (roster.accountedForEventIds.has(eventRecord.id)) {
            continue;
        }

        roster.missedEventIds.add(eventRecord.id);
    }
}

const updates = [];

for (const rosterRecord of rostersQuery.records) {
    const roster = rosterDetails.get(rosterRecord.id);
    const missedEventIds = Array.from(roster.missedEventIds);
    const currentMissedIds = getLinkedIds(
        rosterRecord,
        missedRehearsalsField
    );

    const unchanged =
        currentMissedIds.size === missedEventIds.length &&
        missedEventIds.every(function (eventId) {
            return currentMissedIds.has(eventId);
        });

    if (!unchanged) {
        updates.push({
            id: rosterRecord.id,
            fields: {
                [missedRehearsalsField]: missedEventIds.map(function (id) {
                    return { id: id };
                })
            }
        });
    }
}

for (let index = 0; index < updates.length; index += 50) {
    await rostersTable.updateRecordsAsync(
        updates.slice(index, index + 50)
    );
}

output.set("easternToday", easternToday);
output.set("eventsChecked", eventsQuery.records.length);
output.set("rostersChecked", rostersQuery.records.length);
output.set("attendanceRowsChecked", attendanceQuery.records.length);
output.set("attendanceEventField", attendanceEventField);
output.set("attendanceRosterField", attendanceRosterField);
output.set("rostersUpdated", updates.length);
