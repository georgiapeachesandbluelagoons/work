const eventsTable = base.getTable("Rehearsals/Concerts");
const rostersTable = base.getTable("Ensemble Rosters");

// Exact Airtable field names.
const eventDateField = "Rehearsal Date";
const eventEnsembleField = "Ensemble(s)";
const rosterEnsembleField = "Ensemble Registered";
const attendanceField = "Attendance";
const absenceRequestsField = "Absence Requests";
const missedRehearsalsField = "Missed Rehearsals";

const eventsQuery = await eventsTable.selectRecordsAsync({
    fields: [eventDateField, eventEnsembleField]
});

const rostersQuery = await rostersTable.selectRecordsAsync({
    fields: [
        rosterEnsembleField,
        attendanceField,
        absenceRequestsField,
        missedRehearsalsField
    ]
});

// Get today's date in Eastern Time as YYYY-MM-DD.
const easternToday = new Intl.DateTimeFormat("en-CA", {
    timeZone: "America/New_York",
    year: "numeric",
    month: "2-digit",
    day: "2-digit"
}).format(new Date());

function getLinkedIds(record, fieldName) {
    return new Set(
        (record.getCellValue(fieldName) || [])
            .filter(link => link && link.id)
            .map(link => link.id)
    );
}

// Some Airtable fields that display linked records are configured as lookup
// fields and return names/strings instead of linked-record IDs. Keep both the
// IDs and displayed names so Attendance and Absence Requests are recognized in
// either configuration.
function getLinkedReferences(record, fieldName) {
    const references = record.getCellValue(fieldName) || [];
    const ids = new Set();
    const names = new Set();

    for (const reference of references) {
        if (reference && typeof reference === "object") {
            if (reference.id) {
                ids.add(reference.id);
            }
            if (reference.name) {
                names.add(String(reference.name).trim());
            }
        } else if (reference !== null && reference !== undefined) {
            names.add(String(reference).trim());
        }
    }

    return { ids, names };
}

function getEventDateOnly(record) {
    const value = record.getCellValue(eventDateField);

    if (!value) {
        return null;
    }

    // Airtable date values begin with the event's calendar date.
    return String(value).slice(0, 10);
}

const rosterDetails = new Map();

// Store each student's ensembles and event records already accounted for.
for (const rosterRecord of rostersQuery.records) {
    const attendance = getLinkedReferences(rosterRecord, attendanceField);
    const absenceRequests = getLinkedReferences(
        rosterRecord,
        absenceRequestsField
    );

    rosterDetails.set(rosterRecord.id, {
        ensembleIds: getLinkedIds(rosterRecord, rosterEnsembleField),
        accountedForEventIds: new Set([
            ...attendance.ids,
            ...absenceRequests.ids
        ]),
        accountedForEventNames: new Set([
            ...attendance.names,
            ...absenceRequests.names
        ]),
        missedEventIds: new Set()
    });
}

// Find every past or current event and compare its ensembles to each roster.
for (const eventRecord of eventsQuery.records) {
    const eventDate = getEventDateOnly(eventRecord);

    if (!eventDate || eventDate > easternToday) {
        continue;
    }

    const eventEnsembleIds = getLinkedIds(
        eventRecord,
        eventEnsembleField
    );

    if (eventEnsembleIds.size === 0) {
        continue;
    }

    // record.name is the displayed primary-field value for the event. It lets
    // this work even when Attendance is a lookup that returns event names.
    const eventName = eventRecord.name
        ? String(eventRecord.name).trim()
        : null;

    for (const [rosterId, roster] of rosterDetails) {
        const sameEnsemble = [...eventEnsembleIds].some(
            ensembleId => roster.ensembleIds.has(ensembleId)
        );

        if (!sameEnsemble) {
            continue;
        }

        // An event in either Attendance or Absence Requests is not missed.
        // Check IDs first, then displayed names for lookup/text fields.
        const alreadyAccountedFor =
            roster.accountedForEventIds.has(eventRecord.id) ||
            (eventName && roster.accountedForEventNames.has(eventName));

        if (alreadyAccountedFor) {
            continue;
        }

        roster.missedEventIds.add(eventRecord.id);
    }
}

// Replace each roster's Missed Rehearsals links with the current result.
const updates = [];

for (const rosterRecord of rostersQuery.records) {
    const roster = rosterDetails.get(rosterRecord.id);
    const missedEventIds = [...roster.missedEventIds];
    const currentMissedIds = getLinkedIds(
        rosterRecord,
        missedRehearsalsField
    );

    const unchanged =
        currentMissedIds.size === missedEventIds.length &&
        missedEventIds.every(eventId => currentMissedIds.has(eventId));

    if (!unchanged) {
        updates.push({
            id: rosterRecord.id,
            fields: {
                [missedRehearsalsField]: missedEventIds.map(id => ({ id }))
            }
        });
    }
}

// Airtable allows a maximum of 50 records per update request.
for (let index = 0; index < updates.length; index += 50) {
    await rostersTable.updateRecordsAsync(
        updates.slice(index, index + 50)
    );
}

output.set("easternToday", easternToday);
output.set("eventsChecked", eventsQuery.records.length);
output.set("rostersChecked", rostersQuery.records.length);
output.set("rostersUpdated", updates.length);
