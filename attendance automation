const eventsTable = base.getTable("Rehearsals/Concerts");
const rostersTable = base.getTable("Ensemble Rosters");
const attendanceTable = base.getTable("Attendance");

const eventDateField = "Rehearsal Date";
const eventEnsembleField = "Ensemble(s)";
const rosterEnsembleField = "Ensemble Registered";
const attendanceRosterField = "Attendance";
const attendanceDateField = "Rehearsal Date";
const attendanceEnsembleField = "Ensemble";
const absenceRequestsField = "Absence Requests";
const missedRehearsalsField = "Missed Rehearsals";

function values(record, fieldName) {
    const value = record.getCellValue(fieldName);
    if (value === null || value === undefined) return [];
    return Array.isArray(value) ? value : [value];
}

function linkedIds(record, fieldName) {
    return new Set(values(record, fieldName)
        .filter(function (item) { return item && item.id; })
        .map(function (item) { return item.id; }));
}

function names(record, fieldName) {
    const result = new Set();
    for (const item of values(record, fieldName)) {
        const name = item && typeof item === "object"
            ? (item.name || item.value)
            : item;
        if (name !== null && name !== undefined) {
            const normalized = String(name).trim().toLowerCase();
            if (normalized) result.add(normalized);
        }
    }
    return result;
}

function zero(value) {
    const text = String(value);
    return text.length === 1 ? "0" + text : text;
}

function dateOnly(record, fieldName) {
    for (const item of values(record, fieldName)) {
        let text = item && typeof item === "object"
            ? (item.name || item.value)
            : item;
        if (text === null || text === undefined) continue;
        text = String(text).trim();

        if (text.length >= 10 && text.charAt(4) === "-" && text.charAt(7) === "-") {
            return text.substring(0, 4) + "-" +
                zero(text.substring(5, 7)) + "-" +
                zero(text.substring(8, 10));
        }

        const parts = text.split("/");
        if (parts.length === 3 && parts[2].trim().length === 4) {
            return parts[2].trim() + "-" + zero(parts[0].trim()) +
                "-" + zero(parts[1].trim());
        }

        const parsed = new Date(text);
        if (!isNaN(parsed.getTime())) {
            return parsed.getFullYear() + "-" +
                zero(parsed.getMonth() + 1) + "-" +
                zero(parsed.getDate());
        }
    }
    return null;
}

function common(idsA, namesA, idsB, namesB) {
    for (const id of idsA) if (idsB.has(id)) return true;
    for (const name of namesA) if (namesB.has(name)) return true;
    return false;
}

function hasAttendance(roster, date, eventIds, eventNames) {
    for (const id of eventIds) {
        if (roster.attendanceKeys.has(date + "|id:" + id)) return true;
    }
    for (const name of eventNames) {
        if (roster.attendanceKeys.has(date + "|name:" + name)) return true;
    }
    return false;
}

const today = new Intl.DateTimeFormat("en-CA", {
    timeZone: "America/New_York",
    year: "numeric",
    month: "2-digit",
    day: "2-digit"
}).format(new Date());

const eventsQuery = await eventsTable.selectRecordsAsync({
    fields: [eventDateField, eventEnsembleField]
});
const rostersQuery = await rostersTable.selectRecordsAsync({
    fields: [rosterEnsembleField, attendanceRosterField,
        absenceRequestsField, missedRehearsalsField]
});
const attendanceQuery = await attendanceTable.selectRecordsAsync({
    fields: [attendanceDateField, attendanceEnsembleField]
});

const attendanceById = new Map();
for (const record of attendanceQuery.records) {
    attendanceById.set(record.id, {
        date: dateOnly(record, attendanceDateField),
        ids: linkedIds(record, attendanceEnsembleField),
        names: names(record, attendanceEnsembleField)
    });
}

const rosterDetails = new Map();
for (const record of rostersQuery.records) {
    const attendanceKeys = new Set();
    for (const attendanceId of linkedIds(record, attendanceRosterField)) {
        const attendance = attendanceById.get(attendanceId);
        if (!attendance || !attendance.date) continue;
        for (const id of attendance.ids) {
            attendanceKeys.add(attendance.date + "|id:" + id);
        }
        for (const name of attendance.names) {
            attendanceKeys.add(attendance.date + "|name:" + name);
        }
    }

    // Absence Requests are linked records whose displayed names are dates.
    // Keep both their IDs and normalized dates. The date fallback handles
    // cases where the linked record is not the same event record ID.
    const absenceIds = linkedIds(record, absenceRequestsField);
    const absenceDates = new Set();
    for (const absenceName of names(record, absenceRequestsField)) {
        const parts = absenceName.split("/");
        if (parts.length === 3 && parts[2].length === 4) {
            absenceDates.add(parts[2] + "-" + zero(parts[0]) + "-" + zero(parts[1]));
        }
    }

    rosterDetails.set(record.id, {
        ensembleIds: linkedIds(record, rosterEnsembleField),
        ensembleNames: names(record, rosterEnsembleField),
        attendanceKeys: attendanceKeys,
        absenceIds: absenceIds,
        absenceDates: absenceDates,
        missedIds: new Set()
    });
}

for (const event of eventsQuery.records) {
    const date = dateOnly(event, eventDateField);
    if (!date || date > today) continue;

    const eventIds = linkedIds(event, eventEnsembleField);
    const eventNames = names(event, eventEnsembleField);
    if (eventIds.size === 0 && eventNames.size === 0) continue;

    for (const roster of rosterDetails.values()) {
        if (!common(eventIds, eventNames,
            roster.ensembleIds, roster.ensembleNames)) continue;

        const attended = hasAttendance(roster, date, eventIds, eventNames);
        const directlyExcused = roster.absenceIds.has(event.id);
        const dateExcused = roster.absenceDates.has(date);

        if (!attended && !directlyExcused && !dateExcused) {
            roster.missedIds.add(event.id);
        }
    }
}

const updates = [];
let staleRemoved = 0;

for (const record of rostersQuery.records) {
    const roster = rosterDetails.get(record.id);
    const newIds = Array.from(roster.missedIds);
    const oldIds = linkedIds(record, missedRehearsalsField);

    for (const oldId of oldIds) {
        if (!roster.missedIds.has(oldId)) staleRemoved++;
    }

    const unchanged = oldIds.size === newIds.length &&
        newIds.every(function (id) { return oldIds.has(id); });

    if (!unchanged) {
        updates.push({
            id: record.id,
            fields: {}
        });
        updates[updates.length - 1].fields[missedRehearsalsField] =
            newIds.map(function (id) { return { id: id }; });
    }
}

for (let index = 0; index < updates.length; index += 50) {
    await rostersTable.updateRecordsAsync(updates.slice(index, index + 50));
}

output.set("easternToday", today);
output.set("eventsChecked", eventsQuery.records.length);
output.set("rostersChecked", rostersQuery.records.length);
output.set("attendanceRowsChecked", attendanceQuery.records.length);
output.set("rostersUpdated", updates.length);
output.set("staleMissedLinksRemoved", staleRemoved);
